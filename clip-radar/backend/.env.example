# Supabase Independiente
SUPABASE_URL=https://tu-proyecto-aislado.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=tu-cloudflare-account-id
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=clips-media
# Dominio público del bucket o dominio personalizado (ej. https://pub-xxx.r2.dev o https://clips.tudominio.com)
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# AssemblyAI (Transcripción Universal-2)
ASSEMBLYAI_API_KEY=tu-assemblyai-key

# DeepSeek API (OpenAI Compatible)
DEEPSEEK_API_KEY=tu-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
